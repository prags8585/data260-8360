  {
    "label": "bad email format -> validation error",
    "method": "POST",
    "url": "http://localhost:8260/api/instructors",
    "request_body": {
      "name": "Dr. Bad Email",
      "department": "X",
      "email": "not-an-email"
    },
    "status": 422,
    "expected": 422,
    "pass": true,
    "x_total_count": null,
    "response_body": {
      "detail": [
        {
          "type": "string_pattern_mismatch",
          "loc": [
            "body",
            "email"
          ],
          "msg": "String should match pattern '^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$'",
          "input": "not-an-email",
          "ctx": {
            "pattern": "^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$"
          }
        }
      ]
    }
  },
