{
  "server_file": "domain_server.py",
  "tools": [
    {
      "name": "search_courses",
      "description": "Search the catalogue by course title, code or department (case-insensitive). limit is 1-50.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_coursesArguments",
        "type": "object"
      }
    },
    {
      "name": "course_detail",
      "description": "Full detail for one course by numeric id, including its instructor and seats available.",
      "inputSchema": {
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          }
        },
        "required": [
          "course_id"
        ],
        "title": "course_detailArguments",
        "type": "object"
      }
    },
    {
      "name": "course_stats",
      "description": "Aggregate: number of courses and total seats available, grouped by 'department' or 'instructor'.",
      "inputSchema": {
        "properties": {
          "group_by": {
            "default": "department",
            "title": "Group By",
            "type": "string"
          }
        },
        "title": "course_statsArguments",
        "type": "object"
      }
    }
  ],
  "calls": [
    {
